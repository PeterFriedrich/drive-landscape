# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Data files (scoped to raw inputs and outputs — track dirs via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
output/*
!output/.gitkeep

# Environment variables
.env
.env.*

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store

# Node (if a headless-browser verify harness is added)
node_modules/

# Claude Code personal settings (per-machine permission grants)
.claude/settings.local.json
